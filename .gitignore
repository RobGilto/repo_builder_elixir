# The directory Mix will write compiled artifacts to.
/_build/

# Project-local PostgreSQL data directory (scripts/pg.sh) — never commit a cluster.
/.pgdata/

# Per-session harness scratch workspaces (BUILD_PROMPT.md §6).
/priv/workspaces/

# Dialyzer PLTs — built/cached in CI, never committed (BUILD_PROMPT.md §3).
/priv/plts/*.plt
/priv/plts/*.plt.hash

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
repo_builder-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Local semantic-search index cache (machine-local, not part of the project).
/.memsearch/

# Playwright MCP scratch output (screenshots/snapshots/console logs).
/.playwright-mcp/
/console-current-state.png

# ADW (AI Developer Workflow) runtime artifacts — agent working dirs, isolated
# git worktrees, and Python bytecode caches. Generated per run, never committed.
/agents/
/trees/
__pycache__/

/.planning/

# Local MCP server config — contains a live orchestrator bearer token; never commit.
/.mcp.json

# Local environment variables — contains API keys and secrets; never commit.
# Use .env.sample as a template.
/.env
.env

# Installed plugins are runtime artifacts; the source of truth is plugin_library/ + the store.
/agentic_plugins/*
!/agentic_plugins/.gitkeep

# Forge generation scratch workspaces (forge-meta-artifact-generation)
/priv/forge_scratch/

# Local app secret key — must never be committed.
/.secret_key
# understand-anything analysis artifacts.
/.understand-anything/
