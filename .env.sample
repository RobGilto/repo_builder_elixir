# Environment Variables Template for repo_builder_elixir
#
# USAGE:
# This project does NOT auto-load .env files. To use this template:
# 1. Copy this file to .env: `cp .env.sample .env`
# 2. Fill in real values (never commit .env — it's gitignored)
# 3. Add to mise.toml to auto-load on mise activation:
#
#    [env]
#    _.file = ".env"
#
# 4. Restart your shell or run `mise activate` to apply changes

# ============================================================================
# CRITICAL: ADW (AI Developer Workflow) Runtime
# ============================================================================

# Absolute path to the `claude` binary. Required for ADW workflows to spawn
# Claude Code sessions. Find yours with: which claude
# The Phoenix server MUST be started with this set for ADW runs to work.
CLAUDE_CODE_PATH=/path/to/claude

# ============================================================================
# API Keys — Harness Credentials
# ============================================================================

# Anthropic API key for Claude harness (claude agent runs)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI API key for Pi harness (pi agent runs with OpenAI providers)
OPENAI_API_KEY=sk-proj-...

# ============================================================================
# API Keys — Research Tools
# ============================================================================

# Firecrawl API key for web scraping/research tools
# Get from: https://firecrawl.dev/
FIRECRAWL_API_KEY=fc-...

# ============================================================================
# Phoenix Server Configuration
# ============================================================================

# HTTP port for the Phoenix server (default: 4000)
PORT=4000

# Enable Phoenix server in releases (set to "true" for production releases)
# PHX_SERVER=true

# Webhook HMAC signing secret (for GitHub/external webhooks)
# Generate with: mix phx.gen.secret
# WEBHOOK_SECRET=

# ============================================================================
# Orchestrator Configuration (Optional)
# ============================================================================

# Base URL for orchestrator MCP endpoints (defaults to localhost:4000)
# Override if running on a different host/port
# ORCHESTRATOR_MCP_BASE_URL=http://localhost:4000

# ============================================================================
# Performance Tuning (Optional)
# ============================================================================

# Per-line stdout backpressure ceiling in bytes (default: 16777216 = 16 MiB)
# Raise/lower the OOM backstop without redeploying
# REPO_BUILDER_MAX_LINE_BYTES=16777216

# ============================================================================
# Production-Only Configuration
# ============================================================================
# These are only used when MIX_ENV=prod

# Database connection URL (REQUIRED in production)
# Format: ecto://USER:PASS@HOST/DATABASE
# DATABASE_URL=ecto://postgres:password@localhost/repo_builder_prod

# Secret key base for signing/encrypting cookies (REQUIRED in production)
# Generate with: mix phx.gen.secret
# SECRET_KEY_BASE=

# Public hostname for URL generation (default: example.com)
# PHX_HOST=myapp.com

# Database connection pool size (default: 10)
# POOL_SIZE=10

# Enable IPv6 for database connections (set to "true" or "1")
# ECTO_IPV6=false

# DNS cluster query for Elixir node discovery
# DNS_CLUSTER_QUERY=

# ============================================================================
# Development/Testing (Usually Not Needed)
# ============================================================================

# CI test partitioning (used by mix test in parallel CI environments)
# MIX_TEST_PARTITION=
